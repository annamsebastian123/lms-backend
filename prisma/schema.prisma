datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TUTOR
  LEARNER
}

enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  name         String?
  passwordHash String
  role         Role    @default(LEARNER)

  courses      Course[]
  enrollments  Enrollment[]
  certificates Certificate[]
}

model Course {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  enrollments  Enrollment[]
  modules      Module[]
  certificates Certificate[]

  status CourseStatus @default(DRAFT)

  createdAt DateTime @default(now())
}

model Enrollment {
  id Int @id @default(autoincrement())

  userId   Int
  courseId Int

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Module {
  id    Int    @id @default(autoincrement())
  title String

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  lessons Lesson[]

  createdAt DateTime @default(now())
}

enum VideoSource {
  YOUTUBE
  SELF_HOSTED
}

model Lesson {
  id    Int    @id @default(autoincrement())
  title String

  content String?

  videoSource VideoSource @default(YOUTUBE)
  videoUrl    String?
  duration    Int         @default(0)

  orderIndex Int @default(1)

  moduleId Int
  module   Module @relation(fields: [moduleId], references: [id])

  createdAt DateTime @default(now())

  @@unique([moduleId, orderIndex])
}

model Certificate {
  id Int @id @default(autoincrement())

  userId   Int
  courseId Int

  user   User   @relation(fields: [userId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  issuedAt DateTime @default(now())

  @@unique([userId, courseId])
}
